# Supabase project (client-side, exposed to the browser via Vite).
# Copy to .env.local and fill in. When these are absent the game runs in solo mode.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public WebSocket URL of the dedicated authoritative Colyseus race service.
# Local playtest: ws://localhost:2567
# Production:     wss://race.example.com
VITE_RACE_SERVER_URL=ws://localhost:2567

# When true, the client mints race tickets via the race server's /dev/ticket
# endpoint (requires RACE_DEV_MODE=1 on the server). Never ship this as true
# in a production build.
VITE_RACE_DEV_MODE=true

# Optional: force a fixed obstacle seed for local determinism testing.
# You can also pass ?seed=12345 in the URL.
# VITE_FORCED_SEED=

# ---------------------------------------------------------------------------
# TON wallet (client). When VITE_TONCONNECT_MANIFEST_URL is set the real TON
# Connect flow replaces the playtest mock wallet. Manifest lives in
# public/tonconnect-manifest.json (update url/iconUrl for your host).
# ---------------------------------------------------------------------------
# VITE_TONCONNECT_MANIFEST_URL=https://bugeaters-cey.pages.dev/tonconnect-manifest.json
# VITE_TON_NETWORK=testnet
# VITE_TELEGRAM_BOT_USERNAME=YourBugEatersBot

# ---------------------------------------------------------------------------
# Server-side secrets below are NOT exposed to the client. They are set on the
# Supabase project (Dashboard > Edge Functions > Secrets) and used by the
# Edge Functions in supabase/functions. Listed here for reference only.
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABC...
# RACE_TOKEN_SECRET=...   # same secret on Edge Functions + race server
#
# TON pass NFTs — Edge Function secrets (read-only chain access):
# TON_NETWORK=testnet
# TON_API_KEY=...                 # toncenter (https://t.me/tontestnetapibot), optional
# TONAPI_KEY=...                  # tonapi.io, optional (wallet NFT listing for "Import")
# NFT_COLLECTION_ADDRESS=EQ...    # from `npm run ton:deploy-collection`
# TON_PROOF_SECRET=...            # HMAC for ton_proof challenges (falls back to RACE_TOKEN_SECRET)
# TON_PROOF_DOMAINS=bugeaters-cey.pages.dev
# PUBLIC_APP_URL=https://bugeaters-cey.pages.dev
#
# TON pass NFTs — race server (Fly) secrets; this process MINTS:
# TON_NETWORK=testnet
# TON_API_KEY=...
# TON_TREASURY_MNEMONIC="24 words"   # collection owner wallet (fund on testnet faucet)
# NFT_COLLECTION_ADDRESS=EQ...
# NFT_META_BASE_URL=https://<project-ref>.functions.supabase.co/nft-meta/
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...      # lets the minter read the pass queue + write addresses
