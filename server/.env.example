# =============================================================================
# Authoritative race server configuration
# Copy to `.env` for local runs, or set these on your deploy host.
# =============================================================================

# --- Networking ---
PORT=2567
# Comma-separated list of allowed browser origins (CORS). Defaults to "*" if unset.
WEB_ORIGIN=https://your-telegram-web-app.example

# --- Supabase integration (optional for local smoke tests) ---
# When unset, the server logs results to the console instead of pushing them.
SUPABASE_URL=https://your-project.supabase.co

# --- Shared secret ---
# MUST be identical here and in Supabase Edge Function secrets. Used to (a) verify
# incoming race tickets and (b) sign outgoing sealed results. Rotate before prod.
RACE_TOKEN_SECRET=replace-with-a-64-character-random-secret

# --- Race tuning overrides (all optional; see server/src/config/raceConfig.ts) ---
# Room size band. The "3 to 12 players" rule is enforced from these.
# RACE_MIN_PLAYERS=3
# RACE_MAX_PLAYERS=12
# RACE_DEFAULT_PLAYERS=6
# Timing (milliseconds).
# RACE_TICK_MS=50
# RACE_SNAPSHOT_MS=50
# RACE_DURATION_MS=60000
# RACE_COUNTDOWN_MS=3000
