{
  "name": "bugeaters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:race-server": "tsc -p server/tsconfig.build.json",
    "preview": "vite preview",
    "race-server": "tsx server/src/index.ts",
    "race-server:check": "tsc -p server/tsconfig.json",
    "race-server:test": "tsx server/test/simulation.test.ts && tsx server/test/devTicketWaves.test.ts && tsx server/test/ton.test.ts",
    "ton:compile": "node scripts/ton/compile-contracts.mjs",
    "ton:deploy-collection": "npm run ton:compile && tsx scripts/ton/deploy-collection.ts",
    "ton:collection-info": "tsx scripts/ton/collection-info.ts",
    "smoke:auth-race": "node scripts/auth-race-smoke.mjs",
    "smoke:auth-two-client": "node scripts/auth-two-client-smoke.mjs",
    "test:client-net": "tsx server/test/clientDistanceExtrapolator.test.ts",
    "capture:guide": "node scripts/capture-guide-shots.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name bugeaters"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.27",
    "@colyseus/sdk": "^0.17.43",
    "@supabase/supabase-js": "^2.107.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "@tonconnect/ui": "^3.0.2",
    "colyseus": "^0.17.10",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@colyseus/cloud": "^1.0.12",
    "@ton-community/func-js": "^0.11.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^4.118.0"
  }
}
