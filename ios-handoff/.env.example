# Copy to .env in the Expo app root. All vars are client-safe (EXPO_PUBLIC_*).

# Required for multiplayer. Leave empty to force solo mode (same as Telegram web).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: fixed obstacle seed for deterministic QA (e.g. 12345).
# EXPO_PUBLIC_FORCED_SEED=
